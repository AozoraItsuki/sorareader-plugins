# stray tsc output: if a non-plugin dir ever leaks into the production program,
# it lands here instead of .js/plugins/<lang>/ and the manifest would read stale
# artifacts. tsconfig.production.json pins rootDir to make that a hard error.
.js/plugins/server/
.js/plugins/plugins/
.js/plugins/dist/
